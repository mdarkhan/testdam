# ── Required ──
DATABASE_URL="postgresql://testdam:testdam@localhost:54329/testdam"
# Public origin, no trailing slash. Used for canonical URLs, sitemap and Better Auth.
SITE_URL="http://localhost:3000"
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""

# ── First admin (created by the seed script if no user exists) ──
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD=""

# ── Optional ──
# Days a price stays "fresh" after verification.
FRESH_DAYS=90
# Google Tag Manager container, e.g. GTM-XXXXXXX. Empty = no GTM.
NEXT_PUBLIC_GTM_ID=""
# Central WhatsApp number (01XXXXXXXXX). Empty = each lab's own number.
WHATSAPP_CENTRAL_NUMBER=""
